import React from "react";
import {
  View,
  ScrollView,
  StyleSheet,
  useWindowDimensions,
} from "react-native";
import { useSafeAreaInsets } from "react-native-safe-area-context";
import { colors, spacing } from "../../theme";

export const ScreenLayout = ({
  children,
  header,
  scrollable = true,
  contentContainerStyle,
  style,
}) => {
  const insets = useSafeAreaInsets();
  const { width } = useWindowDimensions();

  // Si la pantalla es tableta o apaisada ancha, limitamos el ancho para que no se deforme
  const isLargeScreen = width >= 768;

  const responsiveContainerStyle = [
    styles.responsiveWrapper,
    isLargeScreen && styles.largeScreenConstraint,
  ];

  return (
    <View
      style={[
        styles.root,
        {
          paddingTop: insets.top,
          paddingLeft: insets.left,
          paddingRight: insets.right,
        },
        style,
      ]}
    >
      {/* Cabecera persistente opcional */}
      {header && <View style={styles.headerWrapper}>{header}</View>}

      {/* Contenido principal adaptativo */}
      {scrollable ? (
        <ScrollView
          style={styles.flexOne}
          contentContainerStyle={[styles.scrollContent, contentContainerStyle]}
          showsVerticalScrollIndicator={false}
          keyboardShouldPersistTaps="handled"
        >
          <View style={responsiveContainerStyle}>{children}</View>
        </ScrollView>
      ) : (
        <View style={[styles.flexOne, styles.staticContent]}>
          <View style={responsiveContainerStyle}>{children}</View>
        </View>
      )}
    </View>
  );
};

const styles = StyleSheet.create({
  root: {
    flex: 1,
    backgroundColor: colors.background,
  },
  flexOne: {
    flex: 1,
  },
  headerWrapper: {
    width: "100%",
    zIndex: 10,
  },
  scrollContent: {
    paddingVertical: spacing.md ?? 16,
    paddingHorizontal: spacing.md ?? 16,
    flexGrow: 1,
  },
  staticContent: {
    paddingVertical: spacing.md ?? 16,
    paddingHorizontal: spacing.md ?? 16,
  },
  responsiveWrapper: {
    width: "100%",
    flex: 1,
  },
  largeScreenConstraint: {
    maxWidth: 680,
    alignSelf: "center",
  },
});
</file>

<file path="src/schemas/blockSchema.js">
import { z } from "zod";

export const TIPOS_BLOQUE = ["clase", "estudio", "repaso", "examen"];
export const DIAS_SEMANA = [
  "Lunes",
  "Martes",
  "Miércoles",
  "Jueves",
  "Viernes",
  "Sábado",
  "Domingo",
];

const timeRegex = /^([01]\d|2[0-3]):([0-5]\d)$/;

export const blockSchema = z
  .object({
    titulo: z
      .string()
      .trim()
      .min(1, "El título es obligatorio")
      .max(50, "El título no puede superar los 50 caracteres"),
    curso: z
      .string()
      .trim()
      .min(1, "El curso es obligatorio")
      .max(40, "El curso no puede superar los 40 caracteres"),
    tipo: z.enum(TIPOS_BLOQUE, {
      errorMap: () => ({ message: "Selecciona un tipo de bloque valido" }),
    }),
    dia: z.enum(DIAS_SEMANA, {
      errorMap: () => ({ message: "Selecciona un día de la semana valido" }),
    }),
    horaInicio: z
      .string()
      .trim()
      .regex(timeRegex, "Formato de hora inválido (HH:MM)"),
    horaFin: z
      .string()
      .trim()
      .regex(timeRegex, "Formato de hora inválido (HH:MM)"),
  })
  .refine(
    (datos) => {
      if (!timeRegex.test(datos.horaInicio) || !timeRegex.test(datos.horaFin)) {
        return true;
      }
      return datos.horaInicio < datos.horaFin;
    },
    {
      message: "La hora de inicio debe ser menor que la hora de fin",
      path: ["horaFin"],
    },
  );

export const blockVacio = {
  titulo: "",
  courso: "",
  tipo: "clase",
  dia: "Lunes",
  horaInicio: "08:00",
  horaFin: "09:00",
};
</file>

