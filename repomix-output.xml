      .min(10, "Cuéntanos un poco más (mínimo 10 caracteres)")
      .max(500, "El mensaje no puede superar los 500 caracteres"),
    aceptaTerminos: z.boolean(),
  })
  .refine((datos) => datos.aceptaTerminos === true, {
